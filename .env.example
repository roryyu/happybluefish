# DeepSeek 大模型配置（命理分析使用）
# 必填：API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：自定义 Base URL（默认官方端点 https://api.deepseek.com）
# 兼容任何 OpenAI 风格的网关，例如 https://api.deepseek.com 或 https://your-proxy.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名（默认 deepseek-chat；推理模型可填 deepseek-reasoner 或 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-chat

# 可选：是否启用思考链（reasoning）。默认空；当模型名匹配 v4-pro/reasoner 时会自动启用。
# 设为 1 可强制开启 thinking + reasoning_effort=high。
DEEPSEEK_THINKING=

# ===== 静态页面部署接口（/api/deploy）鉴权 =====
# Agent 与服务端共享的密钥，用于挑战-响应 HMAC-SHA256 签名。
# 生成方式：openssl rand -hex 32
# 密钥从不在网络上传输，仅用于对 challenge 签名。
DEPLOY_SECRET=replace-with-a-long-random-hex-string

# 可选：部署子目录（相对于 public/），默认 agent，即文件落在 public/agent/ 下，
# 通过 /agent/<path> 访问。隔离部署避免误覆盖 public 中已有内容。
# DEPLOY_SUBDIR=agent
